# Plantilla de variables de entorno. Copiar a `.env.local` y completar.
# NO poner valores reales en este archivo: se versiona en git.
#
#   cp .env.example .env.local

# --- Supabase -----------------------------------------------------------
# Dashboard del proyecto -> Connect -> App Frameworks (Next.js) trae las dos
# primeras ya formateadas. La service_role esta en Project Settings -> API Keys,
# detras del boton "Reveal".
#
# Las claves nuevas de Supabase tienen formato `sb_publishable_...` y
# `sb_secret_...`; las antiguas son JWT (`eyJ...`). Ambas funcionan.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privilegiada: saltea las politicas de RLS. Solo server-side, nunca con
# prefijo NEXT_PUBLIC_ (eso la expondria al browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos (Drizzle) --------------------------------------------
# Dos rutas a la MISMA base. Se obtienen del boton "Connect" del dashboard,
# pestana ORMs. Ambas traen [YOUR-PASSWORD] como marcador: reemplazarlo por la
# password de la base, que esta en Project Settings -> Database.
#
# Esa password no se puede consultar en ninguna parte: se define al crear el
# proyecto y despues solo se puede resetear ("Reset database password").
#
# IMPORTANTE: sin comillas alrededor del valor. drizzle-kit no las interpreta y
# se las come como parte de la URL.

# Runtime de la app. Transaction pooler, puerto 6543. Es el que la app necesita
# porque corre serverless en Vercel: sin pooler, cada instancia abriria su
# propia conexion hasta agotar el limite de Postgres.
DATABASE_URL=

# Solo para drizzle-kit (migraciones e introspeccion). Session pooler, puerto
# 5432. El transaction pooler no sirve aca: no soporta todo lo que hace una
# migracion.
DIRECT_URL=

# --- Tests ---------------------------------------------------------------
# Postgres local para los tests de integracion. Si no esta definida, esos tests
# se saltan en vez de fallar.
#
#   docker compose -f docker-compose.test.yml up -d
#
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/roahoki_test

# --- Admin --------------------------------------------------------------
# Password del panel /admin. En local puede ser cualquier valor; no necesita
# coincidir con la de produccion.
ADMIN_PASSWORD=

# Clave con la que se firman los tokens de sesion del panel. OPCIONAL: si no
# esta, se deriva de ADMIN_PASSWORD y el panel funciona igual.
#
# Conviene definirla. Con un secreto propio, rotar la password del panel no
# cierra las sesiones abiertas, y la clave de firma deja de estar atada a algo
# que ademas se compara en el login.
#
# Generar una con:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ADMIN_SESSION_SECRET=
